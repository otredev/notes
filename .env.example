# Copia este archivo como .env y ajusta los valores.

# Puerto del servidor
PORT=3000

# MongoDB local:
MONGODB_URI=mongodb://127.0.0.1:27017
# …o MongoDB Atlas:
# MONGODB_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos
MONGODB_DB=retrodark

# Clave de acceso opcional. Si la pones, la app te la pedirá en Ajustes.
# Recomendada si el servidor es accesible desde fuera de tu red.
APP_TOKEN=

# Notificaciones push: genera las claves con  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Zona horaria para el MCP (por defecto, la del sistema)
# TIMEZONE=America/New_York
